# MongoDB
MONGODB_URI=

# Firebase
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# Google Gemini API (chatbot)
GEMINI_API_KEY=

# Backend
ENVIRONMENT=development

# --- Backend FastAPI (Fase 2) ---
APP_ENV=development
APP_NAME=CreceActivo
APP_VERSION=0.1.0
MONGODB_DB_NAME=creceactivo
CORS_ORIGINS=["http://localhost:5173"]
# Ruta ABSOLUTA al JSON del service account de Firebase.
# Debe estar FUERA del repo. Ejemplo:
# FIREBASE_SERVICE_ACCOUNT_PATH=/home/tu-usuario/secrets/creceactivo-firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=/ruta/absoluta/fuera/del/repo/firebase-service-account.json
